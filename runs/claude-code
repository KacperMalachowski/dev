#!/usr/bin/env bash

# Install Claude Code CLI tool
set -euo pipefail

if [[ "${AI_CLIENT:-opencode}" == "opencode" ]]; then
    echo "Claude Code: optional; use AI_CLIENT=claude or AI_CLIENT=both to install."
    exit 0
fi

if ! command -v claude &> /dev/null; then
    curl -fsSL https://claude.ai/install.sh | bash
else
    echo "Claude Code is already installed."
fi
