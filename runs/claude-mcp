#!/usr/bin/env bash

set -e

if ! command -v claude &> /dev/null; then
    echo "Claude Code is not installed. Run runs/claude-code first."
    exit 1
fi

# Claude Code reads MCP servers from ~/.claude.json (user scope), not from
# settings.json — so register them through the CLI rather than the .ai build.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR/claude-mcp.d"

echo "Registering MCP servers..."

# shellcheck source=claude-mcp.d/_lib.sh
source "$LIB_DIR/_lib.sh"

# shellcheck source=claude-mcp.d/servers.sh
source "$LIB_DIR/servers.sh"

# Source any overlay drop-ins (e.g. servers-work.sh from a private overlay).
# Files must be named servers-*.sh and be executable; they share _lib.sh helpers.
for _overlay in "$LIB_DIR"/servers-*.sh; do
    [[ -f "$_overlay" ]] || continue
    # shellcheck disable=SC1090
    source "$_overlay"
done
unset _overlay
